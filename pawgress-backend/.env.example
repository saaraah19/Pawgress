# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string — free tier from neon.tech works directly here.
DATABASE_URL=postgresql://user:password@host:5432/pawgress

# Required — no insecure default. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-real-random-secret

# From console.groq.com — no card required.
GROQ_API_KEY=your-groq-api-key-here

# The frontend origin(s) allowed to call this API (CORS). Comma-separated
# if you need more than one — the default below covers both localhost and
# 127.0.0.1 variants of Vite's local dev server, since which one a given
# machine uses can vary. Set to the real deployed frontend URL outside
# local development (no comma needed for a single origin).
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# --- Calendar (Google, read-only, v1) ---
# From Google Cloud Console > APIs & Services > Credentials, an OAuth 2.0
# Client ID of type "Web application". Calendar is opt-in — the app runs
# fine without these set, but /calendar won't work until they are.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Must EXACTLY match a redirect URI registered on that same OAuth client
# in Cloud Console (including scheme, host, port, and path) — a mismatch
# is the single most common reason this flow fails. 127.0.0.1, not
# localhost, for the same reason VITE_API_BASE_URL uses it elsewhere.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/calendar/oauth/callback

# Password reset (2026-09-13) — currently logs the reset link instead of
# emailing it (identity/password_reset.py's send_password_reset_email).
# No env var exists for this yet because there's no real email provider
# wired up — that needs Sarah to pick one (SendGrid/Postmark/SES/plain
# SMTP through an existing account) before any credentials go here.
